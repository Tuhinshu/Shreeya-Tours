# =================================================================
# Shreeya Tours & Travels — Backend API Environment Configuration
# =================================================================
# NOTE: In production, ensure all variables are populated with secure values.
# The server will refuse to start in production if ADMIN_API_KEY is missing or weak.

# Server Settings
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Admin Authentication
# In production, must be at least 32 characters long.
ADMIN_API_KEY=your_admin_api_key_min_32_characters_here

# PostgreSQL / Supabase Database
# Required for persistent production storage.
DATABASE_URL=postgresql://postgres:your_db_password@your_db_host:5432/shreeya_tours
DATABASE_SSL=true

# CashFree Payment Gateway (India UPI, Cards, NetBanking)
# Required for production payments and webhook verification.
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
CASHFREE_ENV=sandbox

# SendGrid Transactional Email (Booking & GST Invoices)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=bookings@shreeyatours.com

# WATI / WhatsApp Cloud API (Automated WhatsApp Dispatches)
WATI_API_URL=https://live-server-wati.wati.io
WATI_ACCESS_TOKEN=your_wati_access_token_here
