# =================================================================
# Shreeya Tours & Travels — Backend API Environment Configuration
# =================================================================

# Server Settings
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Admin Authentication
ADMIN_API_KEY=shreeya-admin-secret-2026

# PostgreSQL Database (Supabase / Render / Local)
# If left unset, the backend automatically uses persistent local JSON storage in backend/data/
DATABASE_URL=postgresql://postgres:password@localhost:5432/shreeya_tours
DATABASE_SSL=true

# CashFree Payment Gateway (Primary India Gateway: UPI, Cards, NetBanking)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=sandbox

# SendGrid Transactional Email (Booking & GST Invoices)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=shreeyatours19@gmail.com

# WATI / WhatsApp Cloud API (Automated Confirmation Dispatches)
WATI_API_URL=https://live-server-wati.wati.io
WATI_ACCESS_TOKEN=your_wati_access_token_here
