# =================================================================
# Shreeya Tours & Travels — Master Environment Variable Reference
# =================================================================
# NOTE: Never commit real credentials or secrets to version control.
# In production, all placeholders below MUST be populated with real, secure values.

# -----------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Next.js / Vercel)
# -----------------------------------------------------------------
# Public URL of the backend API service (Required in production, e.g., https://api.shreeyatours.com)
NEXT_PUBLIC_API_URL=http://localhost:5000

# WhatsApp business number for direct enquiries (e.g. 919876543210 without + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Primary customer support email
NEXT_PUBLIC_CONTACT_EMAIL=info@shreeyatours.com

# -----------------------------------------------------------------
# 2. BACKEND CONFIGURATION (Node.js + Express)
# -----------------------------------------------------------------
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Admin Authentication Secret (CRITICAL: Required in production, minimum 32 characters)
ADMIN_API_KEY=your_admin_api_key_min_32_characters_here

# PostgreSQL / Supabase Database Connection
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgresql://postgres:your_db_password@your_db_host:5432/shreeya_tours
DATABASE_SSL=true

# CashFree Payment Gateway (Production: production / Development: sandbox)
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
CASHFREE_ENV=sandbox

# SendGrid Transactional Email (Booking & GST Invoices)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=bookings@shreeyatours.com

# WATI / WhatsApp Cloud API
WATI_API_URL=https://live-server-wati.wati.io
WATI_ACCESS_TOKEN=your_wati_access_token_here

# -----------------------------------------------------------------
# 3. CMS STUDIO (Sanity)
# -----------------------------------------------------------------
SANITY_STUDIO_PROJECT_ID=your_sanity_project_id_here
SANITY_STUDIO_DATASET=production
